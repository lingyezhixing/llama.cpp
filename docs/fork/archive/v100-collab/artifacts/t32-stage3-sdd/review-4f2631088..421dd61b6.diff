+bool kv_tree::drop_seq(const std::vector<llama_token> & tokens) {
+    if (tokens.empty()) {
+        return false;
+    }
+
+    const kv_tree_match m = match(tokens);
+
+    uint64_t tip = 0;
+    if (m.n_part > 0) {
+        tip = m.part_hash;
+    } else if (m.n_full > 0) {
+        tip = m.path.back();
+    } else {
+        return false;
+    }
+
+    const auto it = seqs.find(tip);
+    if (it == seqs.end()) {
+        return false;
+    }
+
+    remove_seq(it);
+    return true;
+}
