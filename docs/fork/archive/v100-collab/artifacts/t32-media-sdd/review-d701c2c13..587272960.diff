+// position of the last KV cell of a sequence of L tokens
+static llama_pos pos_last_cell(const std::vector<kv_tree_media> & media, size_t L) {
+    if (L == 0) {
+        return -1;
+    }
+    for (const auto & m : media) {
+        if (m.idx <= (int64_t) L - 1 && (int64_t) L - 1 < m.idx + m.n_tok) {
