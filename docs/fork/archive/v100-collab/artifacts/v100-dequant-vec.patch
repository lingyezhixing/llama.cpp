+        return;
+    }
+    const int nthreads = 256;
+    const int grid     = dequantize_vec_grid(nb, nthreads/32);
+    dequantize_row_q5_K_f16_vec_kernel<<<grid, nthreads, 0, stream>>>(vx, y, nb);
+}
